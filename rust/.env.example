# OpenAlbion API (Rust) — copy to .env and adjust.
# Every variable is optional; defaults in parentheses.

HOST=0.0.0.0
PORT=8080

# Directory holding the exported JSON tables (data)
DATA_DIR=data

# Bug reports are appended to $DATA_DIR/bug-reports.jsonl; set this to also
# forward them to Slack like the Laravel app did.
SLACK_WEBHOOK_URL=

# Requests per minute per IP across all /api/* routes (60)
RATE_LIMIT_PER_MINUTE=60

# TTL of the Albion Online Data price proxy cache in seconds (180)
AOD_CACHE_SECONDS=180

# Log level (info)
RUST_LOG=info
